    "dataset": {
        "name": "roneneldan/TinyStories",
        "subset_name": null,
        "num_workers": 0,
        "num_proc": 1
    },
    "checkpoint": {
        "save_dir": "ckpt",
        "save_frequency": 300,
        "load_path": ""
    },
    "logging": {
        "use_wandb": false,
        "project_name": "picotron",
        "run_name": null,
        "log_frequency": 1,
        "log_all_ranks": true
    },
    "environment": {
        "OMP_NUM_THREADS": "1",
        "TOKENIZERS_PARALLELISM": "false",
        "FLASH_ATTEN": "1"
    }
