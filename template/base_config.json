{
    "distributed": {
        "tp_size": 1,
        "sequence_parallel": false,
        "cp_size": 1,
        "cp_mode": "ring",
        "cp_seq_padding_en": false,
        "pp_size": 1,
        "dp_size": 1,
        "pp_engine": "1f1b",
        "backend": "nccl",
        "use_cpu": false
    },
    "model": {
        "name": "JackFram/llama-160m",
